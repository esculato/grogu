{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "labels": [
    "renovate"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "at any time"
  ],
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "github-actions",
    "docker-compose"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Firefly III uses version- prefixed tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fireflyiii/core"],
      "extractVersion": "^version-(?<version>.+)$",
      "versioning": "semver"
    },
    {
      "description": "LinuxServer.io tags: <version>-r<alpine>-ls<build>",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/*"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "LinuxServer Jellyfin: <version>ubu<ubuntu>-ls<build>",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?<compatibility>ubu\\d+)-ls(?<build>\\d+)$"
    },
    {
      "groupName": "Docker minor/patch updates",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Automerge non-major Docker updates",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict",
      "ignoreTests": true,
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Create PRs for major Docker updates",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Automerge non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict",
      "ignoreTests": true,
      "automerge": true,
      "automergeType": "branch",
      "pinDigests": true
    },
    {
      "description": "Create PRs for major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
